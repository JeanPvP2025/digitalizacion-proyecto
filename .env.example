# Public Supabase project values. Never place a service role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# With no Supabase credentials, local development can write demo records beneath .data/.
# Complete Supabase credentials take precedence; filesystem demo data is local development only.
DEMO_MODE=true
